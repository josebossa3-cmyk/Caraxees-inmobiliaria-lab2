@model inmobiliaria.Models.Inmueble

@{
  ViewData["Title"] = "Nuevo Inmueble";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1 mt-3">
      <i class="bi bi-builiding-add text-primary"></i> Nuevo Inmueble
    </h1>
    <p class="text-muted mb-0">Completá los datos para dar de alta un nuevo inmueble.</p>
  </div>
  <a asp-action="Index" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Volver al listado
  </a>
</div>

<div class="row justify-content-center">
  <div class="col-lg-10">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-primary-subtle border-0 py-3">
        <h5 class="mb-0">
          <i class="bi bi-house-door"></i> Datos del inmueble
        </h5>
      </div>

      <div class="card-body p4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
          <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

          <div class="row">

            <div class="col-mb-6 mb-3">
              <label asp-for="PropietarioId" class="form-label fw-semibold">
                <i class="bi bi-person-badge text-muted me-1"></i> Propietario
              </label>
              <select asp-for="PropietarioId" asp-items="ViewBag.Propietario" class="form-select">
                <option value="">-- Seleccione Propietario --</option>
              </select>
              <span asp-validation-for="PropietarioId" class="text-danger small"></span>
            </div>

            <div class="col-mb-6 mb-3">
              <label asp-for="TipoInmuebleId" class="form-label fw-semibold">
                <i class="bi bi-tags text-muted me-1"></i> Tipo de inmueble
              </label>
              <select asp-for="TipoInmuebleId" asp-items="ViewBag.TiposInmueble" class="form-select">
                <option value="">-- Seleccione Tipo --</option>
              </select>
              <span asp-validation-for="TipoInmuebleId" class="text-danger small"></span>
            </div>

            <div class="col-mb-12 mb-3">
              <label asp-for="Direccion" class="form-label fw-semibold">
                <i class="bi bi-geo-alt text-muted me-1"></i> Dirección
              </label>
              <input asp-for="Direccion" class="form-control" placeholder="Calle, numero" />
              <span asp-validation-for="Direccion" class="text-danger small"></span>
            </div>

            <div class="col-mb-4 mb-3">
              <label asp-for="Cupo" class="form-label fw-semibold">
                <i class="bi bi-people text-muted me-1"></i> Cupo máximo
              </label>
              <input asp-for="Cupo" class="form-control" type="number" min="1" />
              <span asp-validation-for="Cupo" class="text-danger small"></span>
            </div>

            <div class="col-mb-4 mb-3">
              <label asp-for="PrecioPorDia" class="form-label fw-semibold">
                <i class="bi bi-cash-coin text-muted me-1"></i> Precio por día
              </label>
              <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01" />
              <span asp-validation-for="PrecioPorDia" class="text-danger small"></span>
            </div>

            <div class="col-mb-4 mb-3">
              <label asp-for="PorcentajeReserva" class="form-label fw-semibold">
                <i class="bi bi-percent text-muted me-1"></i> Porcentaje de reserva
              </label>
              <input asp-for="PorcentajeReserva" class="form-control" type="number" step="0.01" min="0" max="100" />
              <span asp-validation-for="PorcentajeReserva" class="text-danger small"></span>
            </div>

            <div class="col-12 mb-3">
              <label asp-for="Coordenadas" class="form-label fw-semibold">
                <i class="bi bi-map text-muted me-1"></i> Coordenadas</label>
                <input asp-for="Coordenadas" id="coordenadas" class="form-control bg-light" readonly
                       placeholder="Hacé click en el mapa para seleccionar">
                <div id="map" class="rounded shadow-sm mt-2" style="height: 320px;"></div>
              </div>

              <div class="col-12 mb-3">
                <div class="form-check form-switch">
                  <input asp-for="Estado" class="form-check-input" type="checkbox">
                  <label asp-for="Estado" class="form-check-label fw-semibold">
                    <i class="bi bi-toggle-on text-muted me-1"></i> Disponible para alquilar
                  </label>
                </div>
              </div>

              <div class="col-12 mb-3">
                <label class="form-label fw-semibold">
                  <i class="bi bi-images text-muted me-1"></i> Imágenes
                </label>
                <input type="file" name="archivos" id="inputArchivos" multiple accept="image/*" class="form-control"
                       onchange="mostrarPrevia()" class="form-control" />
                <small class="text-muted">La primer imagen va ser portada.</small>
                <div id="previewContainer" class="row row-cols-2 row-cols-md-4 g-2 mt-2"></div>
              </div>
            </div>
            <hr class="my-4">
            <div class="d-flex justify-content-end gap-2">
              <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i> Cancelar
              </a>
              <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle"></i> Guardar
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  @section Scripts {
    <script>
      // son las corrdenadas de villa mercedes
      var lat = -33.666;
      var lon = -65.466;
      var marker;

      var map = L.map('map').setView([lat, lon], 13);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap contributors' }).addTo(map);

      // esto es por si hay coordenadas de antes (en edicion), centrar y poner el marcador

      var coordInput = document.getElementById('coordenadas');
      var coordValue = coordInput.value.trim();
      if (coordValue && coordValue.includes(',')) {
        var parts = coordValue.split(',');
        lat = parseFloat(parts[0].trim());
        lon = parseFloat(parts[1].trim());
        map.setView([lat, lon], 15);
        marker = L.marker([lat, lon], { draggable: true }).addTo(map);
      }

      // cuando hace click en el mapa, coloca o actualiza el marker

      map.on('click', function (e) {
        if (marker) {
          marker.setLatLng(e.latlng);
        } else {
          marker = L.marker(e.latlng, { draggable: true }).addTo(map);
        }
        updateCoordInput(e.latlng);
      });

      // arrastra el marcador y actualiza el input
      function updateCoordInput(latlng) {
        document.getElementById('coordenadas').value = latlng.lat.toFixed(6) + ', ' + latlng.lng.toFixed(6);
      }

      // funcion para mostrar la previa de imagenes
      function mostrarPrevia() {
        var input = document.getElementById('inputArchivos');
        var container = document.getElementById('previewContainer');
        container.innerHTML = '';

        if (input.files) {
          Array.from(input.files).forEach((file, index) => {
            if (!file.type.startsWith('image/')) return;

            var reader = new FileReader();
            reader.onload = function (e) {
              var col = document.createElement('div');
              col.className = 'col';
              col.innerHTML = `
                    <div class="card">
                      <img src="${e.target.result}" class="card-img-top" style="max-height: 120px; object-fit: cover;" alt="Previa" />
                      <div class="card-body p-1 text-center">
                        ${index == 0 ? '<span class="badge bg-primary">Portada</span>' : ''}
                      </div>
                    </div>
                  `;
              container.appendChild(col);
            };
            reader.readAsDataURL(file);
          });
        }
      }
    </script>
  }