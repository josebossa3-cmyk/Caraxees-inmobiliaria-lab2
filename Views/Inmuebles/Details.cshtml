@model inmobiliaria.Models.Inmueble

@{
  ViewData["Title"] = "Detalles de Inmueble";
}

<h1>Detalles</h1>

<div class="row">
  <div class="col-md-6">
    <dl class="row">
      <dt class="col-sm-4">Dirección</dt>
      <dd class="col-sm-8">@Model.Direccion</dd>

      <dt class="col-sm-4">Propietario</dt>
      <dd class="col-sm-8">@Model.Propietario?.NombreCompleto</dd>

      <dt class="col-sm-4">Tipo</dt>
      <dd class="col-sm-8">@Model.TipoInmueble?.Nombre</dd>

      <dt class="col-sm-4">Cupo</dt>
      <dd class="col-sm-8">@Model.Cupo</dd>

      <dt class="col-sm-4">Precio por dia</dt>
      <dd class="col-sm-8">@Model.PrecioPorDia.ToString("C")</dd>

      <dt class="col-sm-4">Porcentaje reserva</dt>
      <dd class="col-sm-8">@Model.PorcentajeReserva%</dd>

      <dt class="col-sm-4">Estado</dt>
      <dd class="col-sm-8">
        <span class="badge @(Model.Estado ? "bg-success" : "bg-secondary")">
          @(Model.Estado ? "Disponible" : "Suspendido")
        </span>
      </dd>
    </dl>
  </div>

  <div class=" col-md-6">
    <h5>Ubicacion</h5>
    @if (!string.IsNullOrEmpty(Model.Coordenadas) && Model.Coordenadas.Contains(','))
    {
      <div id="map" style="height: 300px;"></div>
    }
    else
    {
      <p class="text-muted">Sin coordenadas registradas.</p>
    }
  </div>
</div>

<hr>
<h4>Imagenes</h4>
@if (ViewBag.Imagenes != null && ((List<inmobiliaria.Models.ImagenInmueble>)ViewBag.Imagenes).Count > 0)
{
  var imagenes = (List<inmobiliaria.Models.ImagenInmueble>)ViewBag.Imagenes;
    <div id="carouselInmueble" class="carousel slide" data-bs-ride="carousel">
      <ol class="carousel-indicators">
        @for(int i = 0; i < imagenes.Count; i++){
          <li data-bs-target="#carouselInmueble" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
        }
      </ol>
      <div class="carousel-inner">
        @for(int i = 0; i < imagenes.Count; i++){
          <div class="carousel-item @(i == 0 ? "active" : "")">
            <img src="@imagenes[i].Url" alt="imagen de inmueble" class="d-block w-100 rounded" style="max-height: 400px; object-fit: cover;"/>
            @if(imagenes[i].EsPortada){
              <div class="carousel-caption d-none d-md-block">
                <span class="badge bg-primary">Portada</span>
              </div>
            }
          </div>
        }
      </div>
      @if(imagenes.Count > 1){
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselInmueble" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselInmueble" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Siguiente</span>
        </button>
      }
    </div>
}
else
{
  <p class="text-muted">No hay imagenes cargadas</p>
}

<div class="mt-4">
  <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
  <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

@section Scripts {
  @if (!string.IsNullOrEmpty(Model.Coordenadas) && Model.Coordenadas.Contains(','))
  {
    <script>
      var coords = "@Model.Coordenadas".split(',');
      var lat = parseFloat(coords[0].trim());
      var lon = parseFloat(coords[1].trim());

      var map = L.map('map').setView([lat, lon], 15);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
      }).addTo(map);

      L.marker([lat, lon]).addTo(map);
    </script>
  }
}