@model inmobiliaria.Models.Inmueble

@{
  ViewData["Title"] = "Editar Inmueble";
}

<h1>Editar Inmueble</h1>

<form asp-action="Edit" method="post">
  <input type="hidden" asp-for="Id" />
  <input type="hidden" asp-for="FechaAlta" />
  <div asp-validation-summary="ModelOnly" class="text-danger"></div>
  <div class="mb-3">
    <label asp-for="PropietarioId" class="form-label"></label>
    <select asp-for="PropietarioId" asp-items="ViewBag.Propietario" class="form-select">
      <option value="">-- Seleccione Propietario --</option>
    </select>
    <span asp-validation-for="PropietarioId" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="TipoInmuebleId" class="form-label"></label>
    <select asp-for="TipoInmuebleId" asp-items="ViewBag.TiposInmueble" class="form-select">
      <option value="">-- Seleccione Tipo --</option>
    </select>
    <span asp-validation-for="TipoInmuebleId" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="Direccion" class="form-label"></label>
    <input asp-for="Direccion" class="form-control" />
    <span asp-validation-for="Direccion" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="Cupo" class="form-label"></label>
    <input asp-for="Cupo" class="form-control" type="number" min="1" />
    <span asp-validation-for="Cupo" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="PrecioPorDia" class="form-label"></label>
    <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01" />
    <span asp-validation-for="PrecioPorDia" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="PorcentajeReserva" class="form-label"></label>
    <input asp-for="PorcentajeReserva" class="form-control" type="number" step="0.01" min="0" max="100" />
    <span asp-validation-for="PorcentajeReserva" class="text-danger"></span>
  </div>

  <div class="form-check mb-3">
    <input asp-for="Estado" class="form-check-input" type="checkbox">
    <label asp-for="Estado" class="form-check-label"></label>
  </div>

  <div class="mb-3">
    <label asp-for="Coordenadas" class="form-label">Coordenadas</label>
    <input asp-for="Coordenadas" id="coordenadas" class="form-control" readonly
           placeholder="Hacé click en el mapa para seleccionar">
    <div id="map" style="height: 300px; margin-top: 10px;"></div>
  </div>

  <div class="mb-3">
    <label asp-for="ImagenPortada" class="form-label"></label>
    <input asp-for="ImagenPortada" class="form-control" />
  </div>

  <button type="submit" class="btn btn-success">Guardar Cambios</button>
  <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
  <script>
    // son las corrdenadas de villa mercedes
    var lat = -33.6746;
    var lon = -65.4618;
    var marker;

    var map = L.map('map').setView([lat, lon], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap contributors' }).addTo(map);

    // esto es por si hay coordenadas de antes (en edicion), centrar y poner el marcador

    var coordInput = document.getElementById('coordenadas');
    var coordValue = coordInput.value.trim();
    if (coordValue && coordValue.includes(',')) {
      var parts = coordValue.split(',');
      lat = parseFloat(parts[0].trim());
      lon = parseFloat(parts[1].trim());
      map.setView([lat, lon], 15);
      marker = L.marker([lat, lon], { draggable: true }).addTo(map);
    }

    // cuando hace click en el mapa, coloca o actualiza el marker

    map.on('click', function (e) {
      if (marker) {
        marker.setLatLng(e.latlng);
      } else {
        marker = L.marker(e.latlng, { draggable: true }).addTo(map);
      }
      updateCoordInput(e.latlng);
    });

    // arrastra el marcador y actualiza el input
    function updateCoordInput(latlng) {
      document.getElementById('coordenadas').value = latlng.lat.toFixed(6) + ', ' + latlng.lng.toFixed(6);
    }
  </script>
}