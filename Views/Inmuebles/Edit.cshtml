@model inmobiliaria.Models.Inmueble

@{
  ViewData["Title"] = "Editar Inmueble";
}

<h1>Editar Inmueble</h1>

<form asp-action="Edit" method="post">
  <input type="hidden" asp-for="Id"/>
  <input type="hidden" asp-for="FechaAlta"/>
  <div asp-validation-summary="ModelOnly" class="text-danger"></div>
  <div class="mb-3">
    <label asp-for="PropietarioId" class="form-label"></label>
    <select asp-for="PropietarioId" asp-items="ViewBag.Propietarios" class="form-select">
      <option value="">-- Seleccione Propietario --</option>
    </select>
    <span asp-validation-for="PropietarioId" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="TipoInmuebleId" class="form-label"></label>
    <select asp-for="TipoInmuebleId" asp-items="ViewBag.TiposInmuebles" class="form-select">
      <option value="">-- Seleccione Tipo --</option>
    </select>
    <span asp-validation-for="TipoInmuebleId" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="Direccion" class="form-label"></label>
    <input asp-for="Direccion" class="form-control" />
    <span asp-validation-for="Direccion" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="Cupo" class="form-label"></label>
    <input asp-for="Cupo" class="form-control" type="number" min="1" />
    <span asp-validation-for="Cupo" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="PrecioPorDia" class="form-label"></label>
    <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01" />
    <span asp-validation-for="PrecioPorDia" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="PorcentajeReserva" class="form-label"></label>
    <input asp-for="PorcentajeReserva" class="form-control" type="number" step="0.01" min="0" max="100" />
    <span asp-validation-for="PorcentajeReserva" class="text-danger"></span>
  </div>

  <div class="form-check mb-3">
    <input asp-for="Estado" class="form-check-input" type="checkbox">
    <label asp-for="Estado" class="form-check-label"></label>
  </div>

  <div class="mb-3">
    <label asp-for="Coordenadas" class="form-label"></label>
    <input asp-for="Coordenadas" class="form-control">
  </div>

  <div class="mb-3">
    <label asp-for="ImagenPortada" class="form-label"></label>
    <input asp-for="ImagenPortada" class="form-control" />
  </div>

  <button type="submit" class="btn btn-success">Guardar Cambios</button>
  <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>