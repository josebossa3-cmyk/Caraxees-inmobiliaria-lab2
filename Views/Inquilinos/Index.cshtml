@model List<Inquilino>

<h2>Inquilinos</h2>

<a asp-action="Create">Nuevo inquilino</a>

<table border="1">
    <tr>
        <th>DNI</th>
        <th>Nombre completo</th>
        <th>Teléfono</th>
        <th>Email</th>
        <th>Dirección</th>
        <th>Fecha alta</th>
        <th></th>
    </tr>
    @foreach (var i in Model)
    {
        <tr>
            <td>@i.Dni</td>
            <td>@i.NombreCompleto</td>
            <td>@i.Telefono</td>
            <td>@i.Email</td>
            <td>@i.Direccion</td>
            <td>@i.FechaAlta.ToShortDateString()</td>
            <td>
                <a asp-action="Edit" asp-route-id="@i.Id">Editar</a> |
                <a asp-action="Delete" asp-route-id="@i.Id">Eliminar</a>
            </td>
        </tr>
    }
</table>