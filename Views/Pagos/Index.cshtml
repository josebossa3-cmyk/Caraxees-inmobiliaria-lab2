@model PagosIndexViewModel

@{
    ViewData["Title"] = "Pagos";
    var totalCobrado = Model.Pagos.Where(p => p.Estado == "Activo").Sum(p => p.Importe);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1 mt-3"><i class="bi bi-cash-coin text-success"></i>
            Pagos
        </h1>
        <p class="text-muted mb-0">Registro de transacciones asociadas a reservas</p>
    </div>
    <div class="text-end">
        <span class="text-muted small">Total cobrado</span>
        <div class="fs-4 fw-bold text-success">@totalCobrado.ToString("C")</div>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary-subtle border-0 py-3">
        <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtrar por reserva</h5>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-2">
                <div class="col">
                    <select name="reservaId" class="form-select select2" onchange="this.form.submit()">
                        <option value="">Todas las reservas</option>
                        @foreach (var r in Model.Reservas)
                        {
                            <option value="@r.Id" selected="@(Model.ReservaId == r.Id)">
                                Reserva #@r.Id - @r.Inquilino?.NombreCompleto - @r.Inmueble?.Direccion
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto">

                    <button type="submit" class="btn btn-primary text-nowrap">
                        <i class="bi bi-search"></i> Filtrar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.ReservaSeleccionada != null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info-subtle border-0 py-3">
            <h5 class="mb-0">
                <i class="bi bi-info-circle"></i> Reserva #@Model.ReservaSeleccionada.Id
            </h5>
        </div>
        <div class="card-body">
            <div class="row text-center">

                <div class="col-md-3">
                    <small class="text-muted d-block">Inquilino</small>
                    <strong>@Model.ReservaSeleccionada.Inquilino?.NombreCompleto</strong>
                </div>

                <div class="col-md-3">
                    <small class="text-muted d-block">Total reserva</small>
                    <strong>@Model.TotalReserva.ToString("C")</strong>
                </div>

                <div class="col-md-3">
                    <small class="text-muted d-block">Pagado</small>
                    <strong>@Model.TotalPagado.ToString("C")</strong>
                </div>

                <div class="col-md-3">
                    <small class="text-muted d-block">Saldo pendiente</small>
                    <strong class="@(Model.SaldoPendiente > 0 ? "text-danger" : "text-success")">
                        @Model.SaldoPendiente.ToString("C")
                    </strong>
                </div>
            </div>
        </div>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-success-subtle border-0 py-3">
        <h5 class="mb-0"><i class="bi bi-list-check"></i> Pagos registrados</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Pagos.Count == 0)
        {
            <p class="text-muted p-4 mb-0 text-center">
                <i class="bi bi-inbox fs-3 d-block mb-2"></i> Todavía no hay pagos registrados.
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Reserva</th>
                            <th>Fecha</th>
                            <th>Concepto</th>
                            <th>Importe</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pago in Model.Pagos)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@pago.ReservaId</span></td>
                                <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@pago.Concepto</td>
                                <td class="fw-semibold">@pago.Importe.ToString("C")</td>
                                <td>
                                    <span
                                    class="badge @(pago.Estado == "Activo" ? "bg-success" : "bg-secondary")">@pago.Estado</span>
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (pago.Estado == "Activo")
                                    {
                                        <button type="button" class="btn btn-sm btn-warning" title="Editar concepto"
                                                onclick="loadEditPago(@pago.Id)"><i class="bi bi-pencil"></i></button>
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <button type="button" class="btn btn-sm btn-danger" title="Anular pago"
                                                    data-bs-toggle="modal" data-bs-target="#anularModal" data-id="@pago.Id"
                                                    data-importe="@pago.Importe.ToString("C")" data-concepto="@pago.Concepto"><i
                                                class="bi bi-x-octagon"></i>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Anulado</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.ReservaSeleccionada != null && Model.SaldoPendiente > 0)
{
    <div class="card shadow-sm">
        <div class="card-header bg-primary-subtle border-0 py-3">
            <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Registrar nuevo pago</h5>
        </div>
        <div class="card-body">
            <form asp-action="Crear" method="post" asp-route-id="@Model.ReservaSeleccionada.Id">
                @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Concepto</label>
                        <select name="concepto" id="concepto" class="form-select">
                            <option value="Seña">Seña (@Model.ReservaSeleccionada.PorcentajeReserva%)</option>
                            <option value="Pago parcial">Pago parcial</option>
                            <option value="Pago total">Pago total</option>
                            <option value="Multa">Multa por terminación anticipada</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Importe</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" name="importe" id="importe" class="form-control" step="any" min="0.01"
                                   max="@Model.SaldoPendiente.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                   value="@Model.SaldoPendiente.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                   required>
                        </div>
                        <small class="text-muted">
                            Escribí el monto a pagar. Podes pagar una parte o el total.
                            <br>
                            Saldo pendiente: <strong>@Model.SaldoPendiente.ToString("C")</strong>
                        </small>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="setImporte(@Model.MontoSeña.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), 'Seña')">
                        <i class="bi bi-cash"></i> Seña (@Model.MontoSeña.ToString("C"))
                    </button>
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="setImporte(@((Model.SaldoPendiente / 2).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)), 'Pago parcial')">
                        <i class="bi bi-cash-stack"></i> Mitad (@((Model.SaldoPendiente / 2).ToString("C")))
                    </button>
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="setImporte(@Model.SaldoPendiente.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), 'Pago total')">
                        <i class="bi bi-cash-coin"></i> Total (@Model.SaldoPendiente.ToString("C"))
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Registrar pago
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<div class="modal fade" id="anularModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger-subtle">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Anular pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Anular pago de <strong id="anularImporte"></strong> por concepto
                <strong id="anularConcepto"></strong>?
                <br>
                <small class="text-muted">El pago seguirá visible pero marcado como "Anulado".</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="Anular" method="post" id="anularForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="anularId">
                    <input type="hidden" name="reservaId" value="@Model.ReservaId">
                    <button type="submit" class="btn btn-danger">Anular</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editPagoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning-subtle">
                <h5 class="modal-title"><i class="bi bi-pencil"></i> Editar concepto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="editPagoBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('anularModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            document.getElementById('anularId').value = button.getAttribute('data-id');
            document.getElementById('anularImporte').textContent = button.getAttribute('data-importe');
            document.getElementById('anularConcepto').textContent = button.getAttribute('data-concepto');
        });

        function loadEditPago(id) {
            fetch('/Pagos/EditPartial/' + id).then(r => r.text()).then(html => {
                document.getElementById('editPagoBody').innerHTML = html;
                new bootstrap.Modal(document.getElementById('editPagoModal')).show();
            })
                .catch(e => console.error(e));
        }

        function setImporte(valor, concepto) {
            document.getElementById('importe').value = valor.toFixed(2);
            if (concepto) {
                document.getElementById('concepto').value = concepto;
            }
        }

        $(document).ready(function () {
            $('select[name="reservaId"]').select2({
                theme: 'bootstrap-5',
                language: 'es',
                width: '100%',
                placeholder: '-- Seleccione --',
                allowClear: true
            });
        });
    </script>
}