@model inmobiliaria.Models.PaginadoResult<inmobiliaria.Models.Propietario>

@{
  ViewData["Title"] = "Propietarios";
}

<h1>Propietarios</h1>

<p>
  <a asp-action="Create" class="btn btn-primary">Nuevo Propietario</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
  <div class="input-group">
    <input type="text" name="searchString" value="@Model.Busqueda" class="form-control"
           placeholder="- Buscar por DNI, nombre o email - " />
    <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    @if (!string.IsNullOrEmpty(Model.Busqueda))
    {
      <a asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
    }
  </div>
</form>

<table class="table table-striped">
  <thead>
    <tr>
      <th>DNI</th>
      <th>Nombre Completo</th>
      <th>Teléfono</th>
      <th>Email</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    @foreach (var item in Model.Items)
    {
      <tr>
        <td>@item.DNI</td>
        <td>@item.NombreCompleto</td>
        <td>@item.Telefono</td>
        <td>@item.Email</td>
        <td>
          <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
          <button type="button" class="btn btn-sm btn-warning" onclick="loadEditModal(@item.Id)">Editar</button>
          <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal"
                  data-id="@item.Id" data-nombre="@item.NombreCompleto">Eliminar</button>
        </td>
      </tr>
    }
  </tbody>
</table>

@if (Model.TotalPaginas > 1)
{
  <nav>
    <ul class="pagination">
      <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
        <a class="page-link" asp-action="Index" 
        asp-route-page="@(Model.PaginaActual  - 1)" 
        asp-route-searchString="@Model.Busqueda" >Anterior</a>
      </li>

      @for(int i = 1; i <= Model.TotalPaginas; i++)
      {
        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
          <a class="page-link" asp-action="Index"
          asp-route-page="@i"
          asp-route-searchString="@Model.Busqueda">@i</a>
        </li>
      }

      <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
        <a class="page-link" asp-action="Index"
          asp-route-page="@(Model.PaginaActual + 1)"
          asp-route-searchString="@Model.Busqueda">Siguiente</a>
      </li>
    </ul>
  </nav>
}

<p class="text-muted">Mostrando @Model.Items.Count de @Model.TotalRegistros registros.</p>

<!--  modal para edicion -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editModalLabel">Editar Propietario</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body" id="editModalBody">

      </div>
    </div>
  </div>
</div>

<!--  modal para eliminar propietario -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel">Confirmar eliminacion</h5>
        <button type="button" data-bs-dismiss="modal" class="btn-close" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">Estas seguro de eliminar al Propietario: <strong id="propietarioNombre"></strong>?</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <form asp-action="Delete" id="deleteForm" method="post">
          @Html.AntiForgeryToken()
          <input type="hidden" id="propietarioId" name="id">
          <button type="submit" class="btn btn-danger">Eliminar</button>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    //script del modal para eliminar
    var deleteModal = document.getElementById('deleteModal');
    deleteModal.addEventListener('show.bs.modal', function (event) {
      var button = event.relatedTarget;
      var id = button.getAttribute('data-id');
      var nombre = button.getAttribute('data-nombre');
      document.getElementById('propietarioId').value = id;
      document.getElementById('propietarioNombre').textContent = nombre;
    })

    //script para cargar el form de edicion
    function loadEditModal(id) {
      fetch('/Propietarios/EditPartial/' + id)
        .then(response => response.text())
        .then(html => {
          document.getElementById('editModalBody').innerHTML = html;
          var editModal = new bootstrap.Modal(document.getElementById('editModal'));
          editModal.show();
        })
        .catch(error => {
          console.error('Error al cargar el formulario:', error);
        });
    }
  </script>
}