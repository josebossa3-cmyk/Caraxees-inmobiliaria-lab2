@model IEnumerable<inmobiliaria.Models.Inmueble>

@{
  ViewData["Title"] = "Inmuebles disponibles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1 mt-3">
      <i class="bi bi-calendar-range text-success"></i> Inmuebles disponibles
    </h1>
    <p class="text-muted mb-0">Inmuebles sin reservas vigentes en el rango seleccionado.</p>
  </div>
  <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
</div>

<form method="get" class="card card-body shadow-sm mb-4">
  <div class="row align-items-end">
    <div class="col-md-4">
      <label class="form-label fw-semibold">Desde</label>
      <input type="date" name="desde" value="@(ViewBag.Desde?.ToString("yyyy-MM-dd"))" class="form-control" required>
    </div>
    <div class="col-md-4">
      <label class="form-label fw-semibold">Hasta</label>
      <input type="date" name="hasta" value="@(ViewBag.Hasta?.ToString("yyyy-MM-dd"))" class="form-control" required>
    </div>
    <div class="col-md-4">
      <button type="submit" class="btn btn-primary w-100">
        <i class="bi bi-search"></i> Buscar
      </button>
    </div>
  </div>
</form>

@if (ViewBag.Desde != null && ViewBag.Hasta != null)
{
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Dirección</th>
            <th>Propietario</th>
            <th>Tipo</th>
            <th>Precio/día</th>
          </tr>
        </thead>
        <tbody>
          @if (!Model.Any())
          {
            <tr>
              <td colspan="4" class="text-center text-muted py-4">No hay inmuebles disponibles en ese rango.</td>
            </tr>
          }
          else
          {
            @foreach (var i in Model)
            {
              <tr>
                <td>@i.Direccion</td>
                <td>@i.Propietario?.NombreCompleto</td>
                <td>@i.TipoInmueble?.Nombre</td>
                <td>@i.PrecioPorDia.ToString("C")</td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
    <div class="card-footer bg-white">
      <small class="text-muted">Total: @Model.Count() inmuebles</small>
    </div>
  </div>
}
else
{
  <div class="alert alert-info">
    <i class="bi bi-info-circle me-1"></i> Seleccioná un rango de fechas para ver los inmuebles disponibles.
  </div>
}