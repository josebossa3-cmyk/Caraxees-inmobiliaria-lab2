@model IEnumerable<inmobiliaria.Models.Inmueble>

@{
  ViewData["Title"] = "Inmuebles y dueños";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1 mt-2"><i class="bi bi-building text-primary"></i> Inmuebles y dueños</h1>
    <p class="text-muted mb-0">Listado completo de inmuebles con su propietario.</p>
  </div>
  <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
</div>

<form method="get" class="card card-body shadow-sm mb-4">
  <div class="row align-items-end">
    <div class="col-md-4">
      <label class="form-label fw-semibold">Disponibilidad</label>
      <select name="disponible" class="form-select select2" onchange="this.form.submit()">
        <option value="" selected="@(ViewBag.Disponible == null)">Todos</option>
        <option value="true" selected="@(ViewBag.Disponible == true)">Solo disponibles</option>
        <option value="false" selected="@(ViewBag.Disponible == false)">Solo suspendidos</option>
      </select>
    </div>
    <div class="col-md-4">
      <button type="submit" class="btn btn-primary">
        <i class="bi bi-search"></i> Filtrar
      </button>
    </div>
  </div>
</form>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Direccion</th>
            <th>Propietario</th>
            <th>Tipo</th>
            <th>Precio/dia</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          @if (!Model.Any())
          {
            <tr>
              <td class="text-center text-muted py-4">No hay inmuebles.</td>
            </tr>
          }
          else
          {
            @foreach (var i in Model)
            {
              <tr>
                <td class="fw-semibold">@i.Direccion</td>
                <td>@i.Propietario?.NombreCompleto</td>
                <td>@i.TipoInmueble?.Nombre</td>
                <td>@i.PrecioPorDia.ToString("C")</td>
                <td><span class="badge @(i.Estado ? "bg-success" : "bg-secondary")">
                  @(i.Estado ? "Disponible" : "Suspendido")
                </span></td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer bg-white">
    <small class="text-muted">Total: @Model.Count() inmuebles</small>
  </div>
</div>