@model IEnumerable<inmobiliaria.Models.Reserva>

@{
  ViewData["Title"] = "Reservas por vencer";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1 mt-3">
      <i class="bi bi-alarm text-warning"></i> Reservas por vencer
    </h1>
    <p class="text-muted mb-0">Reservas que terminan en los próximos @ViewBag.Dias días.</p>
  </div>
  <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
</div>

<form method="get" class="card card-body shadow-sm mb-4">
  <div class="row align-items-end">
    <div class="col-md-4">
      <label class="form-label fw-semibold">Días</label>
      <input type="number" name="dias" value="@ViewBag.Dias" min="1" class="form-control">
    </div>
    <div class="col-md-4">
      <button type="submit" class="btn btn-primary">
        <i class="bi bi-search"></i> Buscar
      </button>
    </div>
  </div>
</form>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Inmueble</th>
          <th>Inquilino</th>
          <th>Vence</th>
          <th>Días restantes</th>
        </tr>
      </thead>
      <tbody>
        @if (!Model.Any())
        {
          <tr>
            <td colspan="4" class="text-center text-muted py-4">No hay reservas por vencer en ese periodo</td>
          </tr>
        }
        else
        {
          @foreach (var r in Model)
          {
            var diasRestantes = (r.FechaFin - DateTime.Today).Days;
            <tr>
              <td class="fw-semibold">@r.Inmueble?.Direccion</td>
              <td>@r.Inquilino?.NombreCompleto</td>
              <td>@r.FechaFin.ToString("dd/MM/yyyy")</td>
              <td>
                <span class="badge @(diasRestantes <= 3 ? "bg-danger" : "bg-warning text-dark")">@diasRestantes
                  día(s)</span>
                </td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
    <div class="card-footer bg-white">
      <small class="text-muted">Total: @Model.Count() reservas</small>
    </div>
  </div>