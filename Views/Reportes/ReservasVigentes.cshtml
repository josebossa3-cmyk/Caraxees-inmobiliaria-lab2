@model IEnumerable<inmobiliaria.Models.Reserva>

@{
  ViewData["Title"] = "Reservas vigentes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1 mt-3">
      <i class="bi bi-calendar-check text-success"></i> Reservas vigentes
    </h1>
    <p class="text-muted mb-0">Reservas activas cuya fecha de inicio ya pasó y la de fin aún no.</p>
  </div>
  <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
</div>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Inmueble</th>
          <th>Inquilino</th>
          <th>Desde</th>
          <th>Hasta</th>
          <th>Monto/día</th>
        </tr>
      </thead>
      <tbody>
        @if (!Model.Any())
        {
          <tr>
            <td colspan="5" class="text-center text-muted py-4">No hay reservas vigentes hoy.</td>
          </tr>
        }
        else
        {
          @foreach (var r in Model)
          {
            <tr>
              <td class="fw-semibold">@r.Inmueble?.Direccion</td>
              <td>@r.Inquilino?.NombreCompleto</td>
              <td>@r.FechaInicio.ToString("dd/MM/yyyy")</td>
              <td>@r.FechaFin.ToString("dd/MM/yyyy")</td>
              <td>@r.MontoPorDia.ToString("C")</td>
            </tr>
          }
        }
      </tbody>
    </table>
  </div>
  <div class="card-footer bg-white">
    <small class="text-muted">Total: @Model.Count() reservas</small>
  </div>
</div>