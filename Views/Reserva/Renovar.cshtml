@model Reserva

@{
    ViewData["Title"] = "Renovar Reserva";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1 mt-3">
            <i class="bi bi-arrow-repeat text-success"></i> Renovar Reserva
        </h1>
        <p class="text-muted mb-0">Creá una nueva reserva para el mismo inquilino e inmueble.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver al listado
    </a>
</div>
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="alert alert-info d-flex align-items-center" role="alert">
            <i class="bi bi-info-circle me-2 fs-5"></i>
            <div>
                Se creará una nueva reserva vinculada a la reserva original.
                <strong>N° @Model.ReservaRenovadaDeId</strong>. La reserva original quedará como
                <strong>Finalizada</strong>.
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-success-subtle border-0 py-3">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-plus"></i> Datos de la nueva reserva
                </h5>
            </div>

            <div class="card-body p-4">
                <form asp-action="Renovar" asp-route-id="@Model.ReservaRenovadaDeId" method="post">
                    <input type="hidden" asp-for="ReservaRenovadaDeId">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="InquilinoId" class="form-label fw-semibold">
                                <i class="bi bi-people text-muted me-1"></i> Inquilino
                            </label>
                            <select asp-for="InquilinoId"
                                    asp-items="@(new SelectList(ViewBag.Inquilinos, "Id", "NombreCompleto", Model.InquilinoId))"
                                    class="form-select select2"></select>
                            <span asp-validation-for="InquilinoId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="InmuebleId" class="form-label fw-semibold">
                                <i class="bi bi-building text-muted me-1"></i> Inmueble
                            </label>
                            <select asp-for="InmuebleId"
                                    asp-items="@(new SelectList(ViewBag.Inmuebles, "Id", "Direccion", Model.InmuebleId))"
                                    class="form-select select2"></select>
                            <span asp-validation-for="InmuebleId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="MontoPorDia" class="form-label fw-semibold">
                                <i class="bi bi-cash-coin text-muted me-1"></i> Monto por día
                            </label>
                            <input asp-for="MontoPorDia" class="form-control" />
                            <span asp-validation-for="MontoPorDia" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PorcentajeReserva" class="form-label">
                                <i class="bi bi-percent text-muted me-1"></i> Porcentaje de reserva
                            </label>
                            <input type="number" asp-for="PorcentajeReserva" class="form-control" step="0.01" min="0"
                                   max="100" />
                            <span asp-validation-for="PorcentajeReserva" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaInicio" class="form-label fw-semibold">
                                <i class="bi bi-calendar-event text-muted me-1"></i> Nueva fecha de inicio
                            </label>
                            <input type="date" asp-for="FechaInicio" class="form-control" />
                            <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaFin" class="form-label fw-semibold">
                                <i class="bi bi-calendar-check text-muted me-1"></i> Nueva fecha de fin
                            </label>
                            <input type="date" asp-for="FechaFin" class="form-control" />
                            <span asp-validation-for="FechaFin" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Confirmar Renovación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                theme: 'bootstrap-5',
                language: 'es',
                width: '100%',
                placeholder: '-- Seleccione --',
                allowClear: true
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
