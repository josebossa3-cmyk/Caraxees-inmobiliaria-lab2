@model Reserva

@{
  ViewData["Title"] = "Renovar Reserva";
}

<h2>Renovar Reserva</h2>

<div class="alert alert-info">
  <strong>Reserva Original N° @Model.ReservaRenovadaDeId</strong>
  Se va a crear una nueva reserva con el mismo inquilino e inmueble.
</div>

<form asp-action="Renovar" asp-route-id="@Model.ReservaRenovadaDeId" method="post">
  <input type="hidden" asp-for="ReservaRenovadaDeId">

  <div asp-validation-summary="ModelOnly" class="text-danger"></div>

  <div class="mb-3">
    <label asp-for="InquilinoId" class="form-label">Inquilino</label>
    <select asp-for="InquilinoId" asp-items="@(new SelectList(ViewBag.Inquilinos, "Id", "NombreCompleto"))"
            class="form-select"></select>
    <span asp-validation-for="InquilinoId" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="InmuebleId" class="form-label">Inmueble</label>
    <select asp-for="InmuebleId" asp-items="@(new SelectList(ViewBag.Inmuebles, "Id", "Direccion"))"
            class="form-select"></select>
    <span asp-validation-for="InmuebleId" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="MontoPorDia" class="form-label">Monto por día</label>
    <input asp-for="MontoPorDia" class="form-control" />
    <span asp-validation-for="MontoPorDia" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="FechaInicio" class="form-label">Nueva fecha de inicio</label>
    <input type="date" asp-for="FechaInicio" class="form-control" />
    <span asp-validation-for="FechaInicio" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="FechaFin" class="form-label">Nueva fecha de fin</label>
    <input type="date" asp-for="FechaFin" class="form-control" />
    <span asp-validation-for="FechaFin" class="text-danger"></span>
  </div>

  <div class="mb-3">
    <label asp-for="PorcentajeReserva" class="form-label">Porcentaje de reserva</label>
    <input type="number" asp-for="PorcentajeReserva" step="0.01" min="0" max="100" />
    <span asp-validation-for="PorcentajeReserva" class="text-danger"></span>
  </div>

  <button type="submit" class="btn btn-success">Confirmar Renovación</button>
  <a asp-action="Index" class="btn btn-secondary">Volver</a>

</form>