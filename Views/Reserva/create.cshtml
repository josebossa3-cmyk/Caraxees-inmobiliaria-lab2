@model Reserva

@{
  ViewData["Title"] = "Nueva Reserva";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1 mt-3">
      <i class="bi bi-file-earmark-plus text-primary"></i> Nueva Reserva
    </h1>
    <p class="text-muted mb-0">Completá los datos para registrar una nueva reserva.</p>
  </div>
  <a asp-action="Index" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Volver al listado
  </a>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-primary-subtle border-0 py-3">
        <h5 class="mb-0">
          <i class="bi bi-file-earmark-text"></i> Datos de la reserva
        </h5>
      </div>

      <div class="card-body p-4">

        <form asp-action="Create" method="post">
          <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

          <div class="row">

            <div class="col-md-6 mb-3">
              <label asp-for="InquilinoId" class="form-label fw-semibold">
                <i class="bi bi-people text-muted me-1"></i> Inquilino
              </label>
              <select asp-for="InquilinoId" asp-items="@(new SelectList(ViewBag.Inquilinos, "Id", "NombreCompleto"))"
                      class="form-select select2">
                <option value="">Seleccione un Inquilino</option>
              </select>
              <span asp-validation-for="InquilinoId" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
              <label asp-for="InmuebleId" class="form-label fw-semibold">
                <i class="bi bi-building text-muted me-1"></i> Inmueble
              </label>
              <select asp-for="InmuebleId" asp-items="@(new SelectList(ViewBag.Inmuebles, "Id", "Direccion"))"
                      class="form-select select2" id="InmuebleId">
                <option value="">Seleccione un Inmueble</option>
              </select>
              <span asp-validation-for="InmuebleId" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
              <label asp-for="MontoPorDia" class="form-label fw-semibold">
                <i class="bi bi-cash-coin text-muted me-1"></i> Monto por día
              </label>
              <input asp-for="MontoPorDia" class="form-control bg-light" id="MontoPorDia" readonly />
              <small class="text-muted">Se completa automaticamente según el inmueble seleccionado</small>
              <span asp-validation-for="MontoPorDia" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
              <label asp-for="PorcentajeReserva" class="form-label fw-semibold">
                <i class="bi bi-percent text-muted me-1"></i> Porcentaje de reserva
              </label>
              <input asp-for="PorcentajeReserva" class="form-control bg-light" id="PorcentajeReserva" readonly />
              <small class="text-muted">Se completa automaticamente según el inmueble seleccionado</small>
              <span asp-validation-for="PorcentajeReserva" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
              <label asp-for="FechaInicio" class="form-label fw-semibold">
                <i class="bi bi-calendar-event text-muted me-1"></i> Fecha de Inicio
              </label>
              <input asp-for="FechaInicio" type="date" class="form-control" />
              <span asp-validation-for="FechaInicio" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
              <label asp-for="FechaFin" class="form-label fw-semibold">
                <i class="bi bi-calendar-check text-muted me-1"></i> Fecha de Fin
              </label>
              <input asp-for="FechaFin" type="date" class="form-control" />
              <span asp-validation-for="FechaFin" class="text-danger small"></span>
            </div>
          </div>

          <hr class="my-4">
          <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
              <i class="bi bi-x-circle"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-success">
              <i class="bi bi-check-circle"></i> Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    document.getElementById('InmuebleId').addEventListener('change', function () {
      var inmuebleId = this.value;
      var montoInput = document.getElementById('MontoPorDia');
      var porcentajeInput = document.getElementById('PorcentajeReserva');

      if (!inmuebleId) {
        montoInput.value = '';
        porcentajeInput.value = '';
        return;
      }

      fetch('/Reserva/ObtenerDatosInmueble/' + inmuebleId)
        .then(response => response.json())
        .then(data => {
          montoInput.value = data.precioPorDia;
          porcentajeInput.value = data.porcentajeReserva;
        })
        .catch(error => console.error('Error al obtener datos del inmueble:', error));
    });

    $(document).ready(function () {
      $('.select2').select2({
        theme: 'bootstrap-5',
        language: 'es',
        width: '100%',
        placeholder: '-- Seleccione --',
        allowClear: true
      });
    });
  </script>
}