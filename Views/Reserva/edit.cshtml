@model Reserva

<h2>Editar reserva</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <label>Inquilino</label>
    <select asp-for="InquilinoId" asp-items="@(new SelectList(ViewBag.Inquilinos, "Id", "NombreCompleto"))"></select>
    <br />

    <label>Inmueble</label>
    <select asp-for="InmuebleId" asp-items="@(new SelectList(ViewBag.Inmuebles, "Id", "Direccion"))"></select>
    <br />

    <label>Monto por día</label>
    <input asp-for="MontoPorDia" />
    <br />

    <label>Fecha desde</label>
    <input asp-for="FechaDesde" type="date" />
    <br />

    <label>Fecha hasta</label>
    <input asp-for="FechaHasta" type="date" />
    <br />

    <button type="submit">Guardar cambios</button>
</form>