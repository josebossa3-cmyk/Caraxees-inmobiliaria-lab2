@model List<Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<h1>Reservas</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Reserva</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Inmueble</th>
            <th>Inquilino</th>
            <th>Monto por día</th>
            <th>Fecha inicio</th>
            <th>Fecha fin</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(r.Inmueble?.ImagenPortada))
                        {
                            <img src="@r.Inmueble.ImagenPortada" alt="Inmueble" class="img-thumbnail me-2"
                                 style="max-width: 80px; max-height: 60px; object-fit:cover;" />
                        }
                        else
                        {
                            <span class="text-muted me-2" style="font-size: 0.8rem;">Sin imagen</span>
                        }
                        <span>@r.Inmueble?.Direccion</span>
                    </div>
                </td>
                <td>@r.Inquilino?.NombreCompleto</td>
                <td>@r.MontoPorDia.ToString("C")</td>
                <td>@r.FechaInicio.ToString("dd/MM/yyyy")</td>
                <td>@r.FechaFin.ToString("dd/MM/yyyy")</td>
                <td>
                    @{
                        var badgeClass = r.Estado switch
                        {
                            "Vigente" => "bg-success",
                            "Finalizada" => "bg-secondary",
                            "TerminadaAnticipadamente" => "bg-warning text-dark",
                            _ => "bg-dark"
                        };
                    }
                    <span class="badge @badgeClass">@r.Estado</span>
                </td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-warning">Editar</a>
                    @if (r.Estado == "Vigente")
                    {
                        <form asp-action="Terminar" asp-route-id="@r.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Terminar reserva? Se calcula la multa si corresponde.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-info">Terminar</button>
                        </form>
                        <a asp-action="Renovar" asp-route-id="@r.Id" class="btn btn-sm btn-success">Renovar</a>
                    }
                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-id="@r.Id"
                            data-info="@($"{r.Inquilino?.NombreCompleto} - {r.Inmueble?.Direccion} ({r.FechaInicio:dd/MM/yyyy} al {r.FechaFin:dd/MM/yyyy})")">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!--  modal para eliminar reserva -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirmar eliminacion</h5>
                <button type="button" data-bs-dismiss="modal" class="btn-close" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">Estas seguro de eliminar la Reserva<strong id="reservaInfo"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="Delete" id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="reservaId" name="id">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        //script del modal para eliminar
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var info = button.getAttribute('data-info');
            document.getElementById('reservaId').value = id;
            document.getElementById('reservaInfo').textContent = info;
        })
    </script>
}