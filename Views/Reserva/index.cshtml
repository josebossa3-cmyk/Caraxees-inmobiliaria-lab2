@model List<Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<h1>Reservas</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Reserva</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Inmueble</th>
            <th>Inquilino</th>
            <th>Monto por día</th>
            <th>Fecha inicio</th>
            <th>Fecha fin</th>
            <th>Monto Total</th> 
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(r.Inmueble?.ImagenPortada))
                        {
                            <img src="@r.Inmueble.ImagenPortada" alt="Inmueble" class="img-thumbnail me-2"
                                style="max-width: 80px; max-height: 60px; object-fit:cover;" />
                        }
                        else
                        {
                            <span class="text-muted me-2" style="font-size: 0.8rem;">Sin imagen</span>
                        }
                        <span>@r.Inmueble?.Direccion</span>
                    </div>
                </td>
                <td>@r.Inquilino?.NombreCompleto</td>
                <td>@r.MontoPorDia.ToString("C")</td>
                <td>@r.FechaInicio.ToString("dd/MM/yyyy")</td>
                <td>@r.FechaFin.ToString("dd/MM/yyyy")</td>
                <td>
                    @{
                        var dias = (r.FechaFin - r.FechaInicio).Days;
                        var montoTotal = dias * r.MontoPorDia;
                    }
                    @montoTotal.ToString("C")
                </td>
                <td>
                    @{
                        var badgeClass = r.Estado switch
                        {
                            "Vigente" => "bg-success",
                            "Finalizada" => "bg-secondary",
                            "TerminadaAnticipadamente" => "bg-warning text-dark",
                            _ => "bg-dark"
                        };
                    }
                    <span class="badge @badgeClass">@r.Estado</span>
                </td>
                <td class="text-nowrap">
                    <button type="button" class="btn btn-sm btn-info" onclick="loadDetailsModal(@r.Id)">Detalles</button>
                    <button type="button" class="btn btn-sm btn-warning" onclick="loadEditModal(@r.Id)">Editar</button>
                    @if (r.Estado == "Vigente")
                    {
                        <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#terminarModal"
                                data-id="@r.Id"
                                data-info="@($"{r.Inquilino?.NombreCompleto} - {r.Inmueble?.Direccion}")">
                            Terminar
                        </button>
                        <button type="button" class="btn btn-sm btn-success" onclick="loadRenovarModal(@r.Id)">Renovar</button>
                    }
                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-id="@r.Id"
                            data-info="@($"{r.Inquilino?.NombreCompleto} - {r.Inmueble?.Direccion} ({r.FechaInicio:dd/MM/yyyy} al {r.FechaFin:dd/MM/yyyy})")">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!--  modal para detalles de reserva -->
<div class="modal fade" id="modalDetalles" tabindex="-1" aria-labelledby="modalDetallesLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDetallesLabel">Detalles de Reserva</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalDetallesBody">
                <div class="text-center py-3"><div class="spinner-border text-info" role="status"></div></div>
            </div>
        </div>
    </div>
</div>

<!--  modal para editar reserva -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Editar Reserva</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="editModalBody">
                <div class="text-center py-3"><div class="spinner-border text-warning" role="status"></div></div>
            </div>
        </div>
    </div>
</div>

<!--  modal para renovar reserva -->
<div class="modal fade" id="renovarModal" tabindex="-1" aria-labelledby="renovarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="renovarModalLabel">Renovar Reserva</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="renovarModalBody">
                <div class="text-center py-3"><div class="spinner-border text-success" role="status"></div></div>
            </div>
        </div>
    </div>
</div>

<!--  modal para terminar reserva -->
<div class="modal fade" id="terminarModal" tabindex="-1" aria-labelledby="terminarModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="terminarModalLabel">Terminar Reserva</h5>
                <button type="button" data-bs-dismiss="modal" class="btn-close" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de terminar la reserva de <strong id="terminarReservaInfo"></strong>?
                <p class="text-muted small mt-2">Se calculará la multa si corresponde según los días restantes.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="Terminar" id="terminarForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="terminarReservaId" name="id">
                    <button type="submit" class="btn btn-warning">Confirmar Terminación</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!--  modal para eliminar reserva -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirmar eliminacion</h5>
                <button type="button" data-bs-dismiss="modal" class="btn-close" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">Estas seguro de eliminar la Reserva <strong id="reservaInfo"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="Delete" id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="reservaId" name="id">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadDetailsModal(id) {
            document.getElementById('modalDetallesBody').innerHTML = '<div class="text-center py-3"><div class="spinner-border text-info" role="status"></div></div>';
            var modal = new bootstrap.Modal(document.getElementById('modalDetalles'));
            modal.show();
            fetch('/Reserva/DetailsPartial/' + id)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('modalDetallesBody').innerHTML = html;
                })
                .catch(error => {
                    document.getElementById('modalDetallesBody').innerHTML = '<div class="alert alert-danger">Error al cargar los detalles.</div>';
                });
        }

        function loadEditModal(id) {
            document.getElementById('editModalBody').innerHTML = '<div class="text-center py-3"><div class="spinner-border text-warning" role="status"></div></div>';
            var modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
            fetch('/Reserva/EditPartial/' + id)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('editModalBody').innerHTML = html;
                })
                .catch(error => {
                    document.getElementById('editModalBody').innerHTML = '<div class="alert alert-danger">Error al cargar el formulario.</div>';
                });
        }

        function loadRenovarModal(id) {
            document.getElementById('renovarModalBody').innerHTML = '<div class="text-center py-3"><div class="spinner-border text-success" role="status"></div></div>';
            var modal = new bootstrap.Modal(document.getElementById('renovarModal'));
            modal.show();
            fetch('/Reserva/RenovarPartial/' + id)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('renovarModalBody').innerHTML = html;
                })
                .catch(error => {
                    document.getElementById('renovarModalBody').innerHTML = '<div class="alert alert-danger">Error al cargar el formulario.</div>';
                });
        }

        // Script modal terminar
        var terminarModal = document.getElementById('terminarModal');
        terminarModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var info = button.getAttribute('data-info');
            document.getElementById('terminarReservaId').value = id;
            document.getElementById('terminarReservaInfo').textContent = info;
            document.getElementById('terminarForm').action = '/Reserva/Terminar/' + id;
        });

        // Script modal eliminar
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var info = button.getAttribute('data-info');
            document.getElementById('reservaId').value = id;
            document.getElementById('reservaInfo').textContent = info;
            document.getElementById('deleteForm').action = '/Reserva/Delete/' + id;
        });
    </script>
}