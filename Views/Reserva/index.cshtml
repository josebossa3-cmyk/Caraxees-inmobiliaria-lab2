@model List<Reserva>

<h1>Reservas</h1> 

<a asp-action="Create"> nueva Reserva</a> 

<Table border="1">
  <tr>
        <th>Inquilino</th>
        <th>Inmueble</th>
        <th>Monto x día</th>
        <th>Desde</th>
        <th>Hasta</th>
        <th>Estado</th>
        <th></th>
    </tr>
    @foreach (var r in Model)
    {
        <tr>
        <td>@r.Inquilino.Nombre</td>
        <td>@r.Inmueble.Nombre</td>
        <td>@r.MontoPorDia</td>
        <td>@r.FechaDesde</td>
        <td>@r.FechaHasta</td>
        <td>@r.Estado</td>
        <td> 
        <a asp-action="Edit" asp-route-id="@r.Id">Editar</a>
        <a asp-action="Delete" asp-route-id="@r.Id">Eliminar</a>

        </td>
    </tr>
    }
</Table>