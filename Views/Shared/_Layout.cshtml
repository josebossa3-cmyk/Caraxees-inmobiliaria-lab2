
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inmobiliaria Caraxes</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/inmobiliaria.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
</head>

<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-2">
            <div class="container-fluid px-3">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarApp"
                        aria-controls="navbarApp" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarApp">
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link nav-pill @(currentController == "Home" ? "active" : "")" asp-area=""
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill"></i> Inicio
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "Administrador"){
                        <li class="nav-item">
                            <a class="nav-link nav-pill @(currentController == "Usuarios" ? "active" : "")"
                               asp-controller="Usuarios" asp-action="Index">
                                <i class="bi bi-person-fill"></i> Usuarios
                            </a>
                        </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link nav-pill @(currentController == "Propietarios" ? "active" : "")"
                               asp-area="" asp-controller="Propietarios" asp-action="Index">
                                <i class="bi bi-person-standing"></i> Propietarios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-pill @(currentController == "Inquilinos" ? "active" : "")"
                               asp-area="" asp-controller="Inquilinos" asp-action="Index">
                                <i class="bi bi-people-fill"></i> Inquilinos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-pill @(currentController == "Inmuebles" ? "active" : "")"
                               asp-controller="Inmuebles" asp-action="Index">
                                <i class="bi bi-building"></i> Inmuebles
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-pill @(currentController == "Reserva" ? "active" : "")"
                               asp-controller="Reserva" asp-action="Index">
                                <i class="bi bi-file-earmark-text"></i> Reservas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-pill @(currentController == "Pagos" ? "active" : "")"
                               asp-controller="Pagos" asp-action="Index">
                                <i class="bi bi-cash-coin"></i> Pagos
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <ul class="navbar-nav ms-auto">
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var avatar = User.FindFirst("Avatar")?.Value;
        @if (!string.IsNullOrEmpty(avatar))
        {
            <img src="@avatar" alt="Avatar" style="width:40px;height:40px;object-fit:cover;border-radius:50%;" class="mb-3"  />
        }
        <li class="nav-item">
            <a class="nav-link nav-pill @(currentController == "Perfil" ? "active" : "")"
                               asp-controller="Usuarios" asp-action="Perfil">
                                <span class="nav-link">Hola, @User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                            </a>
            
        </li>
        <li class="nav-item">
            <form asp-controller="Usuarios" asp-action="Logout" method="post" class="d-flex">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link nav-link">Cerrar sesión</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Usuarios" asp-action="Login">Iniciar sesión</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Usuarios" asp-action="Create">Registrarse</a>
        </li>
    }
</ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - inmobiliaria - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
