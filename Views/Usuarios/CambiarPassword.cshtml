@model inmobiliaria.Models.CambiarPasswordDTO

@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<h1>Cambiar Contraseña</h1>

<form asp-action="CambiarPassword" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="PasswordActual" class="form-label"></label>
        <input asp-for="PasswordActual" type="password" class="form-control" />
        <span asp-validation-for="PasswordActual" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PasswordNueva" class="form-label"></label>
        <input asp-for="PasswordNueva" type="password" class="form-control" />
        <span asp-validation-for="PasswordNueva" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmarPasswordNueva" class="form-label"></label>
        <input asp-for="ConfirmarPasswordNueva" type="password" class="form-control" />
        <span asp-validation-for="ConfirmarPasswordNueva" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Actualizar contraseña</button>
</form>

<a asp-action="Perfil" class="btn btn-outline-secondary mt-2">Volver al perfil</a>