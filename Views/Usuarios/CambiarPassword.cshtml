@model inmobiliaria.Models.CambiarPasswordDTO

@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1 mt-3"><i class="bi bi-key text-warning"></i> Cambiar Contraseña</h1>
        <p class="text-muted mb-0">Actualizá tu contraseña de acceso al sistema.</p>
    </div>
    <a asp-action="Perfil" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver al perfil
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning-subtle border-0 py-3">
                <h5 class="mb-0"><i class="bi bi-shield-lock"></i> Seguridad</h5>
            </div>

            <div class="card-body p-4">
                <form asp-action="CambiarPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="PasswordActual" class="form-label fw-semibold">
                            <i class="bi bi-key text-muted me-1"></i> Contraseña actual
                        </label>
                        <input asp-for="PasswordActual" type="password" class="form-control" placeholder="**********"
                               autofocus />
                        <span asp-validation-for="PasswordActual" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordNueva" class="form-label fw-semibold">
                            <i class="bi bi-key-fill text-muted me-1"></i> Nueva Contraseña
                        </label>
                        <input asp-for="PasswordNueva" type="password" class="form-control" placeholder="**********" />
                        <span asp-validation-for="PasswordNueva" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmarPasswordNueva" class="form-label">
                            <i class="bi bi-key-fill text-muted"></i> Confirmar nueva contraseña
                        </label>
                        <input asp-for="ConfirmarPasswordNueva" type="password" class="form-control"
                               placeholder="**********" />
                        <span asp-validation-for="ConfirmarPasswordNueva" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-info d-flex align-items-center mt-3" role="alert">
                        <i class="bi bi-info-circle me-2 fs-5"></i>
                        <small>
                            La contraseña debe tener al menos 6 caracteres. Usá una combinacion de letras, números y
                            simbolos.
                        </small>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Perfil" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Actualizar contraseña
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}