@model inmobiliaria.Models.Usuario

@{
    ViewData["Title"] = "Registrar Usuario";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1 mt-3"><i class="bi bi-person-plus text-primary"></i> Registrar Usuario</h1>
        <p class="text-muted mb-0">Creá una nueva cuenta de usuario en el sistema.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary-subtle border-0 py-3">
                <h5 class="mb-0"><i class="bi bi-person-vcard"></i> Datos</h5>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger danger"></div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">
                                <i class="bi bi-envelope text-muted me-1"></i> Email
                            </label>
                            <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="NombreCompleto" class="form-label fw-semibold">
                                <i class="bi bi-person text-muted me-1"></i> Nombre Completo
                            </label>
                            <input asp-for="NombreCompleto" class="form-control" placeholder="Nombre y apellido" />
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PasswordHash" class="form-label fw-semibold">
                                <i class="bi bi-key text-muted me-1"></i> Contraseña
                            </label>
                            <input asp-for="PasswordHash" type="password" class="form-control"
                                   placeholder="*********" />
                            <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3"><label class="form-label fw-semibold">
                            <i class="bi bi-key-fill text-muted me-1"></i> Confirmar Contraseña
                        </label>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="*********">
                        <span class="text-danger small">@ViewBag.ErrorPassword</span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="" class="form-label fw-semibold">
                            <i class="bi bi-image text-muted me-1"></i> Avatar (opcional)
                        </label>
                        <input type="file" asp-for="AvatarFile" accept="image/*" class="form-control">
                        <small class="text-muted">Formatos: JPG, PNG, GIF.</small>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Registrar usuario
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}