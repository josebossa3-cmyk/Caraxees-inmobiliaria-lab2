@model inmobiliaria.Models.Usuario

@{
  ViewData["Title"] = "Detalles de Usuario";
}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1 mt-3">
      <i class="bi bi-person-vcard text-info"></i> Detalles del Usuario
    </h1>
    <p class="text-muted mb-0">
      Información registrada del Usuario.
    </p>
  </div>
  <a asp-action="Index" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Volver al listado
  </a>
</div>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-info-subtle border-0 py-3">
        <h5 class="mb-0">
          <i class="bi-person-badge"></i> @Model.NombreCompleto
        </h5>
      </div>

      <div class="card-body p-4">
        <dl class="row mb-0">
          <dt class="col-sm-4 fw-semibold">
            <i class="bi bi-envelope text-muted me-1"></i> Email
          </dt>
          <dd class="col-sm-8">           
              <a href="mailto:@Model.Email">@Model.Email</a>
          </dd>

          <dt class="col-sm-4 fw-semibold">
            <i class="bi bi-person text-muted me-1"> Nombre completo</i>
          </dt>
          <dd class="col-sm-8">@Model.NombreCompleto</dd>

          <dt class="col-sm-4 fw-semibold">
            <i class="bi bi-geo-alt text-muted me-1"></i> Rol
          </dt>
          <dd class="col-sm-8">
              @Model.Rol
          </dd>

          <dt class="col-sm-4 fw-semibold">
            <i class="bi bi-calendar-event text-muted me-1"></i> Fecha de Creacion
          </dt>
          <dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy")</dd>
        </dl>
      </div>

      <div class="card-footer bg-white d-flex justify-content-end gap-2 py-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left"></i> Volver
        </a>
      </div>
    </div>
  </div>
</div>