@model List<inmobiliaria.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<h1>Usuarios</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Nombre Completo</th>
            <th>Rol</th>
            <th>Fecha Creación</th>
            <th>Cambiar Rol</>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email</td>
                <td>@u.NombreCompleto</td>
                <td>@u.Rol</td>
                <td>@u.FechaCreacion.ToString("dd/MM/yyyy")</td>
                <td>
                <form asp-action="CambiarRol" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@u.Id" />
                    <select name="nuevoRol" class="form-select form-select-sm">
                        <option value="Empleado" selected="@(u.Rol == "Empleado")">Empleado</option>
                        <option value="Administrador" selected="@(u.Rol == "Administrador")">Admin</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-primary">Cambiar</button>
                </form>
                </td>
            </tr>
        }
    </tbody>
</table>